    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@clerk/testing": "^2.2.4",
    "@event-calendar/core": "^5.7.1",
    "@graphql-codegen/cli": "^7.1.3",
    "@graphql-codegen/typescript": "^6.0.2",
    "@playwright/test": "^1.61.1",
    "@poppanator/sveltekit-svg": "^7.0.0",
