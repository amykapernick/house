    "preview": "vite preview",
    "start": "npm run dev",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "lint": "eslint -c ./config/eslint.config.mjs --fix .",
    "lint:ci": "eslint -c ./config/eslint.config.mjs .",
    "generate": "graphql-codegen",
    "test:a11y:axe": "playwright test",
    "test:a11y:pa11y": "node scripts/run-pa11y.mjs",
    "test:a11y": "npm run test:a11y:axe && npm run test:a11y:pa11y",
    "generate:screenshots": "playwright test tests/screenshots/screenshots-authenticated.spec.ts"
  },
  "author": "Amy Kapernick (https://amyskapers.dev/)",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0"
  },
  "type": "module",
