{
  "name": "household",
  "version": "2.0.0",
  "scripts": {
    "dev": "next dev --experimental-https",
    "build": "next build && cp -r .next/static .next/standalone/.next/ && cp -r public .next/standalone/",
    "build:local": "doppler run -- npm run build",
    "lint": "next lint",
    "start": "doppler run -- npm run dev",
    "clean": "rm -rf .next",
    "api": "cd api && npm run dev",
    "swa": "concurrently \"npm run api\" \"swa start --ssl\""
  },
  "author": "Amy Kapernick <amy@kapers.dev> (https://amyskapers.dev/)",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "overrides": {
    "@mui/x-date-pickers": {
      "date-fns": "^3.6.0"
    },
    "@typescript-eslint/eslint-plugin": {
      "eslint": "^9.3.0"
    },
    "eslint-config-next": {
      "eslint": "^9.3.0"
    }
  },
  "dependencies": {
    "@apollo/server": "^4.10.4",
    "@as-integrations/next": "^3.0.0",
    "@clerk/nextjs": "^5.1.3",
    "@devexpress/dx-react-core": "^4.0.8",
    "@devexpress/dx-react-scheduler": "^4.0.8",
    "@devexpress/dx-react-scheduler-material-ui": "^4.0.8",
