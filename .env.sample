API_URL=

## Base URL playwright.screenshots.config.ts points at for `npm run generate:route-screenshots`
## (route-screenshots-*.spec.ts and their toHaveScreenshot() baselines, see #641). Defaults to
## http://localhost:5173 (vite dev) if unset.
PLAYWRIGHT_BASE_URL=

## Build-time value used to construct the <title> of every page, via getPageTitle() (see pageTitle.ts)
SITE_TITLE=

## Clerk
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=

## Client-side data cache lifetime, in minutes (see fetchClientData.ts). Defaults to 30 if unset.
VITE_CACHE_TTL_MINUTES=30

## Bearer token the service worker sends to household_api's /widget-schedule endpoint
## (Windows 11 Widgets Board support) - scoped read-only, checked directly in that
## function rather than via the shared Clerk/isAuthenticated chokepoint, since the
## caller is a background service worker with no signed-in session. Ships in the
## built JS like any other VITE_ var, so this is a low-value/rotatable token, not a
## real secret - see household_api's WIDGET_ACCESS_TOKEN.
VITE_WIDGET_ACCESS_TOKEN=


CLERK_SECRET_KEY=
CLERK_TEST_USER_EMAIL=
CLERK_TEST_USER_PASSWORD=