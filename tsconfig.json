{
  "compilerOptions": {
    "baseUrl": ".",
    "target": "es5",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@components/*": [
        "src/components/*.astro"
      ],
      "@ts/*": [
        "src/types/*"
      ],
      "@fonts/*": [
        "src/fonts/*"
      ],
      "@partials/*": [
        "src/partials/*.astro"
      ],
      "@img/*": [
        "src/img/*"
      ],
      "@pages/*": [
        "src/pages/*.astro"
      ],
      "@styles/*": [
        "src/styles/*",
      ],
      "@utils/*": [
        "utils/*"
      ],
      "@layouts/*": [
        "src/layouts/*.astro"
      ],
      "@data/*": [
        "_data/*"
      ],
      "@react/*": [
        "src/react/*"
      ],
      "@lib/*": [
        "lib/*"
      ],
      "@auth/*": [
        "src/components/auth/*.astro"
      ]
    },
    "allowJs": true,
    "strict": true
  },
  "exclude": [
    "node_modules"
  ],
  "include": [
    "next-env.d.ts",
    ".next/types/**/*.ts",
    "**/*.ts",
    "**/*.tsx"
  ]
}