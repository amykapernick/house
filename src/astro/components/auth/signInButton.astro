---
import type { HTMLAttributes } from 'astro/types';

type Props = HTMLAttributes<'button'> & {
	children?: any;
}

const { ...attrs } = Astro.props

---

<button
	{...attrs}
	type="button"
	data-auth-sign-in-button
>
  <slot>
	Sign In
  </slot>
</button>

<script>
	import { auth } from '../../../lib/authStore'

	auth.subscribe((clerk) => {
		if (clerk !== null && clerk.isReady()) {
			document.querySelectorAll('button[data-auth-sign-in-button]')
				?.forEach(button => {
					button.addEventListener('click', () => {
						clerk.openSignIn({
							afterSignInUrl: import.meta.env.PUBLIC_CLERK_AFTER_SIGN_IN_URL,
							afterSignUpUrl: import.meta.env.PUBLIC_CLERK_AFTER_SIGN_UP_URL,
						})
					})				
				})
		}
	})
</script>