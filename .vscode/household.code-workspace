{
	"folders": [
		{
			"path": ".."
		},
		{
			"path": "../../household_api"
		}
	],
	"settings": {},
	"tasks": {
		"version": "2.0.0",
		"tasks": [
			{
				"label": "Frontend: npm start",
				"type": "shell",
				"command": "echo 'Waiting for API on :7074...'; for i in $(seq 1 60); do curl -s -o /dev/null http://localhost:7074/graphql && break; sleep 1; done; npm start",
				"isBackground": true,
				"problemMatcher": [],
				"options": {
					"cwd": "${workspaceFolder:house}"
				},
				"runOptions": {
					"runOn": "folderOpen"
				}
			},
			{
				"label": "API: npm run dev",
				"type": "shell",
				"command": "npm run dev",
				"isBackground": true,
				"problemMatcher": [],
				"options": {
					"cwd": "${workspaceFolder:household_api}"
				},
				"runOptions": {
					"runOn": "folderOpen"
				}
			}
		]
	}
}