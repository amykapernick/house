{
	"compilerOptions": {
		"paths": {
			"$components": [
				"../src/lib/components"
			],
			"$components/*": [
				"../src/lib/components/*"
			],
			"$partials": [
				"../src/lib/components/partials"
			],
			"$partials/*": [
				"../src/lib/components/partials/*"
			],
			"$parts": [
				"../src/lib/components/parts"
			],
			"$parts/*": [
				"../src/lib/components/parts/*"
			],
			"$layouts": [
				"../src/lib/components/layouts"
			],
			"$layouts/*": [
				"../src/lib/components/layouts/*"
			],
			"$utils": [
				"../src/lib/utils"
			],
			"$utils/*": [
				"../src/lib/utils/*"
			],
			"$types": [
				"../src/lib/types"
			],
			"$types/*": [
				"../src/lib/types/*"
			],
			"$data": [
				"../src/lib/data"
			],
			"$data/*": [
				"../src/lib/data/*"
			],
			"$img": [
				"../src/lib/img"
			],
			"$img/*": [
				"../src/lib/img/*"
			],
			"$styles": [
				"../src/lib/styles"
			],
			"$styles/*": [
				"../src/lib/styles/*"
			],
			"$lib": [
				"../src/lib"
			],
			"$lib/*": [
				"../src/lib/*"
			],
			"$app/types": [
				"./types/index.d.ts"
			]
		},
		"rootDirs": [
			"..",
			"./types"
		],
		"verbatimModuleSyntax": true,
		"isolatedModules": true,
		"lib": [
			"esnext",
			"DOM",
			"DOM.Iterable"
		],
		"moduleResolution": "bundler",
		"module": "esnext",
		"noEmit": true,
		"target": "esnext"
	},
	"include": [
		"ambient.d.ts",
		"env.d.ts",
		"non-ambient.d.ts",
		"./types/**/$types.d.ts",
		"../vite.config.js",
		"../vite.config.ts",
		"../src/**/*.js",
		"../src/**/*.ts",
		"../src/**/*.svelte",
		"../test/**/*.js",
		"../test/**/*.ts",
		"../test/**/*.svelte",
		"../tests/**/*.js",
		"../tests/**/*.ts",
		"../tests/**/*.svelte"
	],
	"exclude": [
		"../node_modules/**",
		"../src/service-worker.js",
		"../src/service-worker/**/*.js",
		"../src/service-worker.ts",
		"../src/service-worker/**/*.ts",
		"../src/service-worker.d.ts",
		"../src/service-worker/**/*.d.ts"
	]
}