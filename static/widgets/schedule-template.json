{
	"type": "AdaptiveCard",
	"body": [
		{
			"type": "TextBlock",
			"size": "Medium",
			"weight": "Bolder",
			"wrap": true,
			"text": "${block}"
		},
		{
			"type": "TextBlock",
			"spacing": "Small",
			"isSubtle": true,
			"wrap": true,
			"text": "${timeLeft}"
		}
	],
	"$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
	"version": "1.5"
}
